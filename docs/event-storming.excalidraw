      "isDeleted": false,
      "boundElements": [],
      "updated": 1794495193261,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 6,
      "text": "- An item can’t be dispensed if its\nstock is 0. Otherwise: Purchase\nRejected - Out of Stock.\n- The balance must be at least the\nprice. Otherwise: Purchase Rejected -\nInsufficient Funds.\n- Change must be payable with the\ncoins available. Otherwise: Purchase\nRejected - Change Unavailable.\n- The selector must match an item.\nOtherwise: Purchase Rejected -\nUnknown Item.\n- After a sale balance should be 0\n- Change dispense only if change > 0",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "KeCYoAHnX8jUy2OQP6M_1",
      "originalText": "- An item can’t be dispensed if its stock is 0. Otherwise: Purchase Rejected - Out of Stock.\n- The balance must be at least the price. Otherwise: Purchase Rejected - Insufficient Funds.\n- Change must be payable with the coins available. Otherwise: Purchase Rejected - Change Unavailable.\n- The selector must match an item. Otherwise: Purchase Rejected - Unknown Item.\n- After a sale balance should be 0\n- Change dispense only if change > 0",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b01",
      "created": 1794226423803,
      "labelPosition": null,
      "baseFontSize": null
    },
